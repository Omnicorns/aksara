{{!
    @template theme_aksara/login

    Split-screen login page: brand panel on the left, the standard login form on the right.

    Example context (json):
    {
        "sitename": "Aksara",
        "sitefullname": "E-Learning Aksara",
        "tagline": "Belajar, berdiskusi, dan mengumpulkan tugas dalam satu tempat.",
        "year": "2026",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Login page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headers keep HTML validators happy</h1>"
        }
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="aksara-login">
        <aside class="aksara-login__aside" aria-hidden="true">
            <div class="aksara-login__brand">
                <span class="aksara-login__mark">{{sitename}}</span>
            </div>
            <div class="aksara-login__intro">
                <p class="aksara-login__title">{{sitefullname}}</p>
                {{#tagline}}<p class="aksara-login__tagline">{{{tagline}}}</p>{{/tagline}}
            </div>
            <p class="aksara-login__meta">&copy; {{year}} {{sitename}}</p>
        </aside>

        <div id="page-content" class="aksara-login__main">
            <div id="region-main-box">
                <div id="region-main">
                    <div class="login-wrapper">
                        <div class="login-container">
                        {{{ output.main_content }}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
