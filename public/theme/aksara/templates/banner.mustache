{{!
    @template theme_aksara/banner

    Coloured banner around the standard page header on landing pages.

    Example context (json):
    {
        "header": "<header id=\"page-header\"><h1>Dashboard</h1></header>",
        "variant": "mydashboard",
        "eyebrow": "Thursday, 8 October 2026",
        "greeting": "Good afternoon, Budi",
        "hasmeta": true,
        "meta": [{"icon": "", "text": "3 courses"}],
        "image": ""
    }
}}
<div class="aksara-banner aksara-banner--{{variant}}{{#image}} has-image{{/image}}"{{#image}} style="background-image: url('{{image}}');"{{/image}}>
    <div class="aksara-banner__inner">
        {{#eyebrow}}<p class="aksara-banner__eyebrow">{{eyebrow}}</p>{{/eyebrow}}
        {{#greeting}}<p class="aksara-banner__greeting">{{greeting}}</p>{{/greeting}}
        {{{header}}}
        {{#hasmeta}}
        <ul class="aksara-banner__meta">
            {{#meta}}<li>{{{icon}}}<span>{{text}}</span></li>{{/meta}}
        </ul>
        {{/hasmeta}}
    </div>
</div>
